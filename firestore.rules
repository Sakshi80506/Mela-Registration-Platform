rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    function isKaarigar() {
      return isAuthenticated() && getUserRole() == 'kaarigar';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true; // Publicly viewable
      allow create, update, delete: if isAdmin();
    }

    // Kaarigars Collection (Artisan profiles)
    match /kaarigars/{kaarigarId} {
      allow read: if true; // Publicly viewable
      allow create: if isAuthenticated();
      allow update: if isUser(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Kaarigar Applications
    match /kaarigarApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isKaarigar() || isAuthenticated();
      allow update: if isAdmin(); // Only admin can approve/reject
      allow delete: if isAdmin();
    }

    // Visitor Registrations (RSVPs)
    match /visitorRegistrations/{registrationId} {
      allow read: if isAuthenticated() && (resource.data.visitorId == request.auth.uid || isAdmin());
      allow create: if true; // Allows registered or guest visitors
      allow delete: if isAuthenticated() && (resource.data.visitorId == request.auth.uid || isAdmin());
    }
  }
}
