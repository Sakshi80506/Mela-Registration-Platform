rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update, write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete, write: if isAuthenticated();
    }

    // Kaarigars Collection (Artisan profiles)
    match /kaarigars/{kaarigarId} {
      allow read: if true;
      allow create, update, write, delete: if isAuthenticated();
    }

    // Kaarigar Applications
    match /kaarigarApplications/{applicationId} {
      allow read: if true;
      allow create, update, write, delete: if isAuthenticated();
    }

    // Visitor Registrations (RSVPs)
    match /visitorRegistrations/{registrationId} {
      allow read: if true;
      allow create: if true;
      allow update, write, delete: if isAuthenticated();
    }

    // Event Reviews & Feedback Collection
    match /eventReviews/{reviewId} {
      allow read: if true;
      allow create, update, write: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
